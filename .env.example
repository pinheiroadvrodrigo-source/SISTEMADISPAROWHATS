# Login do painel
NUXT_ADMIN_EMAIL=voce@empresa.com
NUXT_ADMIN_PASSWORD=troque-esta-senha
# Segredo da sessão (mínimo 32 caracteres aleatórios)
NUXT_SESSION_SECRET=coloque-aqui-uma-frase-longa-com-mais-de-32-caracteres

# Webhook da Meta (o mesmo texto que você digitar no painel da Meta)
NUXT_WEBHOOK_VERIFY_TOKEN=um-token-qualquer-que-voce-inventar
# App Secret do seu app na Meta (Configurações > Básico). Valida a assinatura dos webhooks.
NUXT_META_APP_SECRET=

# Opcionais
NUXT_GRAPH_VERSION=v23.0
NUXT_DATABASE_PATH=./data/disparos.db
NUXT_DEFAULT_COUNTRY_CODE=55
